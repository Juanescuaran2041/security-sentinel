+"""Checksum utilities — weak crypto patterns."""
+import hashlib
+
+
+def file_checksum_md5(filepath: str) -> str:
+    """Calculate file checksum — vulnerable via hashlib.md5."""
+    hasher = hashlib.md5()
+    with open(filepath, "rb") as f:
+        for chunk in iter(lambda: f.read(4096), b""):
+            hasher.update(chunk)
+    return hasher.hexdigest()
+
+
+def verify_integrity_sha1(data: bytes, expected: str) -> bool:
+    """Verify integrity — vulnerable via hashlib.sha1."""
+    actual = hashlib.sha1(data).hexdigest()
+    return actual == expected
+
+
+def quick_hash(value: str) -> str:
+    """Quick hash for caching — vulnerable direct md5 call pattern."""
+    return hashlib.md5(value.encode()).hexdigest()
