+"""Import handler with multiple deserialization vulnerabilities."""
+import pickle
+import shelve
+import jsonpickle
+
+
+def import_user_data(serialized: bytes):
+    """Import from client — vulnerable via pickle.loads."""
+    user_data = pickle.loads(serialized)
+    return user_data
+
+
+def load_legacy_store(db_path: str):
+    """Load legacy data — vulnerable via shelve.open."""
+    db = shelve.open(db_path)
+    data = dict(db)
+    db.close()
+    return data
+
+
+def deserialize_payload(payload_str: str):
+    """Deserialize API payload — vulnerable via jsonpickle.decode."""
+    obj = jsonpickle.decode(payload_str)
+    return obj
