 import sqlite3
+from typing import Optional
 
 
 def get_connection():
     return sqlite3.connect("app.db")
 
 
+def get_user_by_name(name: str):
+    """Fetch user by name — vulnerable to SQL injection via f-string."""
+    conn = get_connection()
+    query = f"SELECT * FROM users WHERE username = '{name}'"
+    return conn.execute(query).fetchone()
+
+
+def search_products(keyword: str):
+    """Search products — vulnerable via .format()."""
+    conn = get_connection()
+    query = "SELECT id, name, price FROM products WHERE name LIKE '%{}%'".format(keyword)
+    return conn.execute(query).fetchall()
+
+
+def delete_old_records(table: str, days: int):
+    """Delete records — vulnerable via %-formatting."""
+    conn = get_connection()
+    query = "DELETE FROM %s WHERE created_at < NOW() - INTERVAL '%s days'" % (table, days)
+    conn.execute(query)
+    conn.commit()
+
+
+def update_email(user_id, new_email):
+    """Update email — vulnerable via string concatenation."""
+    conn = get_connection()
+    query = "UPDATE users SET email = '" + new_email + "' WHERE id = " + str(user_id)
+    conn.execute(query)
+    conn.commit()
+
+
 def get_all_users():
     conn = get_connection()
     return conn.execute("SELECT * FROM users").fetchall()
