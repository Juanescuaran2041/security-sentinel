# ============================================================
# Security PR Guardian — variables de entorno requeridas
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el .env con valores reales.
# ============================================================

# ------------------------------------------------------------
# GitHub (obligatorio)
# ------------------------------------------------------------
# Token de acceso personal con permisos: repo (read) + pull_requests (write)
# Genera uno en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Amazon Bedrock (obligatorio cuando llm_backend=bedrock, default)
# ------------------------------------------------------------
# Región AWS donde está habilitado Bedrock
BEDROCK_REGION=us-east-1

#   anthropic.claude-sonnet-4-20250514-v1:0  (recomendado)
#   anthropic.claude-3-5-haiku-20241022-v1:0  (más rápido, si tienes acceso)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Credenciales AWS IAM (si no usas perfiles de AWS CLI o roles de instancia)
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# AWS_SESSION_TOKEN=                      # Solo si usas credenciales temporales STS

# ------------------------------------------------------------
# Anthropic API (opcional — solo si llm_backend=anthropic en config.yaml)
# Útil para desarrollo local sin credenciales AWS
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Opcionales (también configurables en config.yaml)
# ------------------------------------------------------------
# Tiempo máximo de espera para OSV.dev en segundos (1-300, default: 10)
# OSV_TIMEOUT_SECONDS=10

# Número máximo de líneas del diff a analizar (1-10000, default: 10000)
# MAX_DIFF_LINES=10000

# Número máximo de dependencias a consultar en CVE lookup (1-1000, default: 50)
# MAX_DEPENDENCIES=50
