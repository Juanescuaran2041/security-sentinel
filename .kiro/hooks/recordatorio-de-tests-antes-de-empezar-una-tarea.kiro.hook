{
  "version": "1.0.0",
  "enabled": true,
  "name": "Recordatorio de tests antes de empezar una tarea",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "\"Antes de dar por completada esta tarea, confirma que vas a escribir los tests unitarios/propiedad correspondientes según tasks.md, no solo el código de producción.\""
  }
}